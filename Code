# Section 3: Data Cleaning and Transformation 
# Step 3.1: Create a Cleaned Table for Country 

CREATE TABLE land_temps_by_country_clean AS SELECT dt,YEAR(dt) AS year, MONTH(dt) AS month, country, avg_temp, avg_temp_uncertainty FROM land_temps_by_country WHERE avg_temp IS NOT NULL; 

 

Verify: SELECT * FROM land_temps_by_country_clean LIMIT 5; 

# Step 3.2: Create a Cleaned City Table 

CREATE TABLE land_temps_by_city_clean AS SELECT dt, YEAR(dt) AS year, MONTH(dt) AS month, city, country, avg_temp, avg_temp_uncertainty, latitude, longitude FROM land_temps_by_city WHERE avg_temp IS NOT NULL; 

 

Verify: SELECT * FROM land_temps_by_city_clean LIMIT 5; 

# Step 3.3: Create a Cleaned Table for Global Temperature Average 

CREATE TABLE global_temperatures_clean AS SELECT dt, YEAR(dt) AS year, MONTH(dt) AS month, land_avg_temp, land_ocean_avg_temp FROM global_temperatures WHERE land_avg_temp IS NOT NULL; 

 

Verify: SELECT * FROM global_temperatures_clean LIMIT 5; 

# Step 3.3: Create a Cleaned Table for Global Temperature Average 

CREATE TABLE global_temperatures_clean AS SELECT dt, YEAR(dt) AS year, MONTH(dt) AS month, land_avg_temp, land_ocean_avg_temp FROM global_temperatures WHERE land_avg_temp IS NOT NULL; 

 

Verify: SELECT * FROM global_temperatures_clean LIMIT 5; 

# Section 4: Specific Analysis and Export Output to Excel or Tableau 
# Step 4.1 Create a cleaned data for three centuries analysis: 

 
INSERT OVERWRITE DIRECTORY '/user/nkon/climate/output/century_avg' ROW FORMAT DELIMITED FIELDS TERMINATED BY ',' SELECT CASE WHEN year BETWEEN 1800 AND 1899 THEN '1800s' WHEN year BETWEEN 1900 AND 1999 THEN '1900s' WHEN year BETWEEN 2000 AND 2013 THEN '2000s' END AS period, AVG(avg_temp) AS avg_temp FROM land_temps_by_country_clean WHERE year BETWEEN 1800 AND 2013 GROUP BY CASE WHEN year BETWEEN 1800 AND 1899 THEN '1800s' WHEN year BETWEEN 1900 AND 1999 THEN '1900s' WHEN year BETWEEN 2000 AND 2013 THEN '2000s' END; 

# Step 4.2: Global Temperature Trend 

INSERT OVERWRITE DIRECTORY '/user/nkon/climate/output/global_year' ROW FORMAT DELIMITED FIELDS TERMINATED BY ',' SELECT year, AVG(land_avg_temp) AS avg_temp FROM global_temperatures_clean GROUP BY year ORDER BY year; 

# Step 4.3: Country by Average 

INSERT OVERWRITE DIRECTORY '/user/nkon/climate/output/country_avg' ROW FORMAT DELIMITED FIELDS TERMINATED BY ',' SELECT country, AVG(avg_temp) AS avg_temp FROM land_temps_by_country_clean GROUP BY country ORDER BY avg_temp DESC; 

# Step 4.4: Country Temperature Change Trend Pattern 

INSERT OVERWRITE DIRECTORY '/user/nkon/climate/output/country_change' ROW FORMAT DELIMITED FIELDS TERMINATED BY ',' SELECT country, AVG(CASE WHEN year BETWEEN 1900 AND 1920 THEN avg_temp END) AS early_temp, AVG(CASE WHEN year BETWEEN 2000 AND 2013 THEN avg_temp END) AS recent_temp, AVG(CASE WHEN year BETWEEN 2000 AND 2013 THEN avg_temp END) - AVG(CASE WHEN year BETWEEN 1900 AND 1920 THEN avg_temp END) AS temp_change FROM land_temps_by_country_clean GROUP BY country; 

